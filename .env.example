# ShopVerse ADMIN app. Uses the SAME Firebase project as the customer app: "shopverse21-831fc".
# Firebase WEB config is public by design (safe in the browser). Security comes from firestore.rules + Cloud Functions role checks.
# Copy to .env.local and fill API_KEY + APP_ID from Firebase Console > Project settings > Your apps > Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shopverse21-831fc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=shopverse21-831fc
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=shopverse21-831fc.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=413026494596
NEXT_PUBLIC_FIREBASE_APP_ID=

# Must match the region of the deployed Cloud Functions (default us-central1).
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1

# Optional: public URL of the customer app, used only to add "View on storefront" links. No trailing slash.
NEXT_PUBLIC_STOREFRONT_URL=

# NEVER put a service-account JSON, Admin SDK private key or any server secret in this file, in NEXT_PUBLIC_* variables, or in git.
